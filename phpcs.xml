<?xml version="1.0"?>
<ruleset name="Utmatra">
	<description>Coding standard for Utmatra.</description>

	<file>utm-attribution-tracker.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>views</file>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<rule ref="WordPress">
		<!-- Project uses PSR-4-style class file names (src/DB/Schema.php). -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Analytics event table is queried directly by design; results are real-time. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<!-- WordPress hook and shortcode callbacks must keep the full signature. -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>

	<!-- Plugin minimum PHP is 8.0 (see plugin header). -->
	<config name="minimum_wp_version" value="6.0"/>
</ruleset>
